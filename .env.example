# Copy to .env (gitignored); leave empty until setting a fresh operator token.
# Generate out of band: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Not a production IAM system: never share tokens or bind to 0.0.0.0 on the host.
W04_PRIVATE_TOKEN=

# Separate high-entropy key for HMAC-scoped P25 permits. Not a browser secret.
W04_P25_PERMIT_KEY=
